#!/usr/bin/env bash
set -euo pipefail

readonly PROGRAM="frog-host-setup"
readonly VERSION="0.1.0-alpha.1"

dry_run=false
assume_yes=false
json=false
verify_only=false
declare -a requested=()
declare -a missing=()
declare -a install_packages=()

usage() {
  cat <<'EOF'
Prepare a host for standard SSH/Mosh access and persistent terminal sessions.

Usage: frog-host-setup [options]

Options:
  --component NAME  Select openssh, mosh, or tmux (repeatable; default: all)
  --dry-run         Print the exact plan without changing the host
  --yes             Apply the displayed plan without an interactive prompt
  --verify-only     Check prerequisites without installing anything
  --json            Emit a machine-readable result
  --version         Print the version
  -h, --help        Show this help

The tool never changes sshd configuration or shell/tmux configuration.
Package installation may invoke sudo only after the plan is displayed and
consent is given.
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit "${2:-2}"
}

json_escape() {
  local value=${1//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

contains() {
  local needle=$1
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

while (($#)); do
  case "$1" in
    --component)
      (($# >= 2)) || die "--component requires a value"
      case "$2" in
        openssh|mosh|tmux)
          contains "$2" "${requested[@]:-}" || requested+=("$2")
          ;;
        *) die "unsupported component '$2'; expected openssh, mosh, or tmux" ;;
      esac
      shift 2
      ;;
    --dry-run) dry_run=true; shift ;;
    --yes) assume_yes=true; shift ;;
    --verify-only) verify_only=true; shift ;;
    --json) json=true; shift ;;
    --version) printf '%s %s\n' "$PROGRAM" "$VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done

if ((${#requested[@]} == 0)); then
  requested=(openssh mosh tmux)
fi

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

component_ready() {
  case "$1" in
    openssh) command_exists ssh && command_exists sshd ;;
    mosh) command_exists mosh && command_exists mosh-server ;;
    tmux) command_exists tmux ;;
  esac
}

detect_package_manager() {
  if [[ ${FROG_HOST_SETUP_OS:-} == darwin ]] || [[ -z ${FROG_HOST_SETUP_OS:-} && $(uname -s) == Darwin ]]; then
    command_exists brew && { printf 'brew'; return; }
    printf 'none'
    return
  fi

  local candidate
  for candidate in apt-get dnf pacman; do
    command_exists "$candidate" && { printf '%s' "$candidate"; return; }
  done
  printf 'none'
}

packages_for() {
  local manager=$1 component=$2
  case "$manager:$component" in
    brew:openssh) printf 'openssh' ;;
    brew:mosh) printf 'mosh' ;;
    brew:tmux) printf 'tmux' ;;
    apt-get:openssh) printf 'openssh-client openssh-server' ;;
    apt-get:mosh) printf 'mosh' ;;
    apt-get:tmux) printf 'tmux' ;;
    dnf:openssh) printf 'openssh-clients openssh-server' ;;
    dnf:mosh) printf 'mosh' ;;
    dnf:tmux) printf 'tmux' ;;
    pacman:openssh) printf 'openssh' ;;
    pacman:mosh) printf 'mosh' ;;
    pacman:tmux) printf 'tmux' ;;
    *) return 1 ;;
  esac
}

for component in "${requested[@]}"; do
  component_ready "$component" || missing+=("$component")
done

manager=$(detect_package_manager)
if ((${#missing[@]} > 0)); then
  [[ "$manager" != none ]] || die "missing ${missing[*]} and no supported package manager was found" 3
  for component in "${missing[@]}"; do
    read -r -a component_packages <<<"$(packages_for "$manager" "$component")"
    for package in "${component_packages[@]}"; do
      contains "$package" "${install_packages[@]:-}" || install_packages+=("$package")
    done
  done
fi

needs_sudo=false
if [[ "$manager" != brew && ${EUID:-$(id -u)} -ne 0 ]]; then
  needs_sudo=true
fi

declare -a install_command=()
if ((${#install_packages[@]} > 0)); then
  $needs_sudo && install_command+=(sudo)
  case "$manager" in
    brew) install_command+=(brew install "${install_packages[@]}") ;;
    apt-get) install_command+=(apt-get install -y --no-install-recommends "${install_packages[@]}") ;;
    dnf) install_command+=(dnf install -y --setopt=install_weak_deps=False "${install_packages[@]}") ;;
    pacman) install_command+=(pacman -S --needed --noconfirm "${install_packages[@]}") ;;
  esac
fi

print_json_array() {
  local first=true value
  printf '['
  for value in "$@"; do
    $first || printf ','
    first=false
    printf '"%s"' "$(json_escape "$value")"
  done
  printf ']'
}

emit_result() {
  local state=$1
  if $json; then
    printf '{"schema_version":1,"state":"%s","package_manager":"%s","requested":' \
      "$(json_escape "$state")" "$(json_escape "$manager")"
    print_json_array "${requested[@]}"
    printf ',"missing":'
    print_json_array "${missing[@]}"
    printf ',"packages":'
    print_json_array "${install_packages[@]}"
    printf ',"requires_sudo":%s}\n' "$needs_sudo"
  else
    printf 'Host setup: %s\n' "$state"
    printf 'Package manager: %s\n' "$manager"
    printf 'Requested: %s\n' "${requested[*]}"
    if ((${#missing[@]} > 0)); then
      printf 'Missing: %s\n' "${missing[*]}"
      printf 'Plan:'
      printf ' %q' "${install_command[@]}"
      printf '\n'
    fi
  fi
}

if ((${#missing[@]} == 0)); then
  emit_result ready
  exit 0
fi

if $verify_only; then
  emit_result missing
  exit 4
fi

if $dry_run; then
  emit_result planned
  exit 0
fi

if ! $assume_yes; then
  emit_result awaiting-consent
  [[ -t 0 ]] || die "refusing to install without an interactive terminal; rerun with --yes after reviewing --dry-run" 5
  printf 'Apply this plan? [y/N] ' >&2
  read -r reply
  [[ "$reply" == y || "$reply" == Y || "$reply" == yes || "$reply" == YES ]] || die "cancelled" 5
fi

"${install_command[@]}"

missing=()
for component in "${requested[@]}"; do
  component_ready "$component" || missing+=("$component")
done
if ((${#missing[@]} > 0)); then
  emit_result verification-failed
  exit 6
fi

if contains tmux "${requested[@]}"; then
  socket_name="frog-host-setup-$$"
  tmux -L "$socket_name" -f /dev/null new-session -d true
  tmux -L "$socket_name" kill-server
fi

emit_result installed
